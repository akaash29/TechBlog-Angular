{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "94b2cb6f-b94f-45cc-a164-28e3556ed8fe"
  },
  "newProjectRoot": "projects",
  "projects": {
    "UserBlog-Angular": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "public/assets/css/base.css",
              "public/assets/css/app.css",
              "public/assets/css/auth.css",
              "public/assets/css/dashboard.css",
              "public/assets/css/journal.css",
              "public/assets/css/post.css",
              "public/assets/css/feed.css",
              "public/assets/css/messages.css",
              "public/assets/css/writers.css",
              "public/assets/css/profile.css",
              "public/assets/css/compose.css",
              "public/assets/css/responsive.css",
              "src/styles.css"
            ],
            "scripts": [
              "public/assets/js/icons.js",
              "public/assets/js/common.js",
              "public/assets/js/data.js",
              "public/assets/js/blog.js",
              "public/assets/js/auth.js",
              "public/assets/js/dashboard.js",
              "public/assets/js/journal.js",
              "public/assets/js/feed.js",
              "public/assets/js/post.js",
              "public/assets/js/messages.js",
              "public/assets/js/writers.js",
              "public/assets/js/profile.js",
              "public/assets/js/compose.js"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "UserBlog-Angular:build:production"
            },
            "development": {
              "buildTarget": "UserBlog-Angular:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
